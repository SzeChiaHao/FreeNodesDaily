<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <com.journeyapps.barcodescanner.BarcodeView
        android:id="@+id/barcode_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.szech.walls.ui.scan.ScanOverlayView
        android:id="@+id/scan_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageButton
        android:id="@+id/scan_close"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="start|top"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/scan_close"
        android:src="@drawable/ic_close"
        app:tint="#FFFFFFFF" />

    <ImageButton
        android:id="@+id/scan_torch"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="48dp"
        android:background="@drawable/bg_scan_round"
        android:contentDescription="@string/scan_torch"
        android:src="@drawable/ic_bolt"
        app:tint="#FFFFFFFF" />
</FrameLayout>
